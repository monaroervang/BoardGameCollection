@page "/register"
@using System.Net
@using System.Net.Http.Json

<PageTitle>Register</PageTitle>

<h1>Create account</h1>

<div class="mb-3">
    <label for="username" class="form-label">Username</label>
    <input id="username"
           class="form-control"
           @bind="_username" />
</div>

<div class="mb-3">
    <label for="password" class="form-label">Password</label>
    <input id="password"
           type="password"
           class="form-control"
           @bind="_password" />
</div>

<button class="btn btn-primary"
        disabled="@_isSubmitting"
        @onclick="RegisterAsync">
    Register
</button>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <p class="mt-3" role="status">@_message</p>
}

@code {
    private string _username = "";
    private string _password = "";
    private string _message = "";
    private bool _isSubmitting;

    private async Task RegisterAsync()
    {
        _isSubmitting = true;
        _message = "";

        try
        {
            using var client = new HttpClient();

            using var response = await client.PostAsJsonAsync(
                "http://localhost:8080/auth/register",
                new
                {
                    Username = _username,
                    Password = _password
                });

            if (response.IsSuccessStatusCode)
            {
                _message = "Account created!";
                _password = "";
            }
            else if (response.StatusCode == HttpStatusCode.Conflict)
            {
                _message = "Username is already taken.";
            }
            else if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                _message = await response.Content
                    .ReadFromJsonAsync<string>()
                    ?? "Check your username and password.";
            }
            else
            {
                _message = $"Registration failed ({(int)response.StatusCode}).";
            }
        }
        catch (HttpRequestException)
        {
            _message = "Unable to contact the gateway.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
