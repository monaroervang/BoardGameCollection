@page "/boardgames/{BoardGameId:guid}"

@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Shared.DTOs.BoardGames.Responses
@using Shared.DTOs.Items.Requests
@using Shared.DTOs.Items.Responses

@inject HttpClient Http

<PageTitle>Brætspilsdetaljer</PageTitle>

@if (isLoading)
{
    <p>Indlæser brætspil...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>

    <a class="btn btn-outline-secondary"
       href="/boardgames">
        Tilbage til brætspil
    </a>
}
else if (boardGame is not null)
{
    <div class="mb-4">
        <a class="btn btn-outline-secondary"
           href="/boardgames">
            Tilbage til brætspil
        </a>
    </div>

    <h1>@boardGame.Title</h1>

    <p class="text-muted">
        @boardGame.Genre
    </p>

    <div class="card mb-4">
        <div class="card-body">

            <p>
                <strong>Udgiver:</strong>
                @boardGame.Publisher
            </p>

            @if (!string.IsNullOrWhiteSpace(boardGame.Edition))
            {
                <p>
                    <strong>Udgave:</strong>
                    @boardGame.Edition
                </p>
            }

            <p>
                <strong>Udgivelsesår:</strong>
                @boardGame.ReleaseYear
            </p>

            <p>
                <strong>Spillere:</strong>
                @boardGame.MinPlayers-@boardGame.MaxPlayers
            </p>

            <p>
                <strong>Minimumsalder:</strong>
                @boardGame.MinimumAge+
            </p>

            <p>
                <strong>Spilletid:</strong>
                @boardGame.PlayingTimeMinutes min.
            </p>

            <p>
                <strong>Beskrivelse:</strong>
                @boardGame.Description
            </p>

        </div>
    </div>

    @* Allow authenticated users to add a physical copy. *@
    <AuthorizeView>
        <Authorized>
            <div class="mb-4">
                <button class="btn btn-primary"
                        disabled="@isAddingItem"
                        @onclick="AddToCollectionAsync">
                    @(isAddingItem
                        ? "Tilføjer..."
                        : "Tilføj til min samling")
                </button>
            </div>
        </Authorized>
    </AuthorizeView>

    @if (!string.IsNullOrWhiteSpace(addItemSuccessMessage))
    {
        <div class="alert alert-success" role="status">
            @addItemSuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(addItemErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @addItemErrorMessage
        </div>
    }

    <h2>Fysiske eksemplarer</h2>

    @if (items.Count == 0)
    {
        <p class="text-muted">
            Der er endnu ikke registreret nogen fysiske
            eksemplarer af dette brætspil.
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Ejer</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in items)
                    {
                        <tr @key="item.ItemId">
                            <td>
                                @item.OwnerUsername
                            </td>

                            <td>
                                @if (item.IsArchived)
                                {
                                    <span class="badge bg-secondary">
                                        Arkiveret
                                    </span>
                                }
                                else if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">
                                        Ledigt
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Udlånt
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    // The board game ID is read from the route.
    [Parameter]
    public Guid BoardGameId { get; set; }

    // Contains the board game retrieved from the API.
    private BoardGameResponse? boardGame;

    // Contains the physical copies of the selected board game.
    private List<BoardGameItemResponse> items = [];

    // Variables used to control loading and error messages.
    private bool isLoading = true;
    private string? errorMessage;

    // Variables used to control the add-to-collection operation.
    private bool isAddingItem;
    private string? addItemSuccessMessage;
    private string? addItemErrorMessage;

    // Reload the data when the board game route parameter changes.
    protected override async Task OnParametersSetAsync()
    {
        await LoadBoardGameAsync();

        // Only fetch physical copies if the board game was found.
        if (boardGame is not null)
        {
            await LoadItemsAsync();
        }
    }

    // Fetch the selected board game from the API.
    private async Task LoadBoardGameAsync()
    {
        isLoading = true;
        errorMessage = null;
        boardGame = null;
        items = [];

        addItemSuccessMessage = null;
        addItemErrorMessage = null;

        try
        {
            var response = await Http.GetAsync(
                $"api/boardgames/{BoardGameId}");

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                errorMessage = "Brætspillet blev ikke fundet.";
                return;
            }

            response.EnsureSuccessStatusCode();

            boardGame = await response.Content
                .ReadFromJsonAsync<BoardGameResponse>();
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Brætspillet kunne ikke hentes fra API'et.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Fetch all physical copies of the selected board game.
    private async Task LoadItemsAsync()
    {
        try
        {
            items = await Http
                .GetFromJsonAsync<List<BoardGameItemResponse>>(
                    $"api/items/boardgame/{BoardGameId}") ?? [];
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "De fysiske eksemplarer kunne ikke hentes fra API'et.";
        }
    }

    // Add a physical copy to the authenticated user's collection.
    private async Task AddToCollectionAsync()
    {
        if (isAddingItem || boardGame is null)
        {
            return;
        }

        isAddingItem = true;
        addItemSuccessMessage = null;
        addItemErrorMessage = null;

        try
        {
            // The API determines OwnerId from the validated JWT.
            var request = new CreateItemRequest
            {
                BoardGameId = BoardGameId
            };

            var response = await Http.PostAsJsonAsync(
                "api/items",
                request);

            if (response.StatusCode == HttpStatusCode.Created)
            {
                addItemSuccessMessage =
                    "Spillet er tilføjet til din samling.";

                // Refresh the list to display the new physical copy.
                await LoadItemsAsync();
            }
            else if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                addItemErrorMessage =
                    "Din session er udløbet. Log ind igen.";
            }
            else
            {
                addItemErrorMessage =
                    "Spillet kunne ikke tilføjes til din samling.";
            }
        }
        catch (HttpRequestException)
        {
            addItemErrorMessage =
                "Der kunne ikke oprettes forbindelse til API'et.";
        }
        finally
        {
            isAddingItem = false;
        }
    }
}
